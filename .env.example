# Build-time public values. Placeholders only. Do not put secrets here.
# Preview builds stay noindex unless PUBLIC_INDEXABLE is exactly "true".
PUBLIC_INDEXABLE=false
PUBLIC_TURNSTILE_SITE_KEY=
SITE_URL=https://cyberpiratelabs.com

# Worker secrets are set with `wrangler secret put`, not in this file.
