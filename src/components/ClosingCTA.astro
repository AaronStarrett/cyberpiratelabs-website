---
interface Props { title?: string; text?: string; href?: string; label?: string; eyebrow?: string; }
const {title = "Put the next step to work.", text = "Explore the ten core solutions, or bring a different workflow to a custom automation consultation.", href = "/demo/", label = "Request a CPL Demo", eyebrow = "A useful software solution starts with your business"} = Astro.props;
---
<section class="closing"><div class="wrap closing-inner"><div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p>{text}</p></div><a class="button light" href={href}>{label} <span aria-hidden="true">&nearr;</span></a></div><span class="closing-word" aria-hidden="true">LET'S TALK.</span></section>
