---
import type { Solution } from "../../shared/solutions";
import "../styles/solutions.css";

interface Props { solution: Solution; compact?: boolean; }
const { solution, compact = false } = Astro.props;
const shortProblems: Record<string, string> = {
  "01": "Missing calls when you're closed?",
  "02": "Interruptions from unsuitable sales calls?",
  "03": "Quote requests missing the details?",
  "04": "Answering the same questions again?",
  "05": "Customers unsure which service fits?",
  "06": "New customers unsure how to prepare?",
  "07": "Visitors looking for the booking page?",
  "08": "Routine setup questions reaching the team?",
  "09": "Feedback arriving without useful context?",
  "10": "Staff searching for the right procedure?",
};
const icons: Record<string, string> = {
  "01": "M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a14 14 0 0 1-7-7l2-2-2-5Zm8 0v5l3 2m-5-2a5 5 0 1 0 10 0 5 5 0 0 0-10 0Z",
  "02": "M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a14 14 0 0 1-7-7l2-2-2-5Zm6 4h8m-4-4 4 4-4 4",
  "03": "M8 4H4v17h16V4h-4M8 2h8v5H8V2Zm0 9h8m-8 4h8m-8 3h5",
  "04": "M4 5h16v11H9l-5 4V5Zm4 4h8M8 12h5",
  "05": "M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm11 3 2 2 4-5",
  "06": "M4 5h16v16H4V5Zm4-3v6m8-6v6M8 13l3 3 5-6",
  "07": "M4 5h16v16H4V5Zm4-3v6m8-6v6M4 10h16m-9 4h6m-3-3 3 3-3 3",
  "08": "M9 4 4 9l4 4 5-5-4-4Zm3 7 8 8m-8-3-6 6-4-4 6-6m8-8 2 2 4-4a6 6 0 0 1-8 8",
  "09": "M4 4h16v12H9l-5 4V4Zm8 3v4m0 2v.5",
  "10": "M4 4h5a3 3 0 0 1 3 3v14a4 4 0 0 0-4-3H4V4Zm8 3a3 3 0 0 1 3-3h5v14h-4a4 4 0 0 0-4 3",
};
---
<article class:list={["solution-card", `solution-card--${solution.group}`, `solution-card--${solution.delivery}`, { "solution-card--compact": compact }]}>
  <div class="solution-card-top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[solution.id]} /></svg>
    <span class="solution-delivery">{solution.delivery === "voice" ? "Voice" : "Chat"}</span>
  </div>
  <p class="solution-card-problem">{compact ? shortProblems[solution.id] : solution.problem}</p>
  <h3><a href={`/solutions/${solution.slug}/`}>{solution.name}<span class="solution-card-hit" aria-hidden="true"></span></a></h3>
  <p class="solution-card-benefit">{solution.benefit}</p>
  {compact && <span class="solution-card-output"><span aria-hidden="true">↳</span>{solution.demo.resultTitle}</span>}
  <span class="solution-card-link" aria-hidden="true">Explore this solution <span>↗</span></span>
</article>
