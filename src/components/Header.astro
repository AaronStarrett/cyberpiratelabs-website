---
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Cyber Pirate Labs home"><img src="/brand/cpl-logo.png" width="1254" height="1254" alt="" /><span>Cyber Pirate Labs<small>CONVERSATIONS. PUT TO WORK.</small></span></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" type="button">Menu <span aria-hidden="true">☰</span></button>
    <nav id="site-nav" class="nav" aria-label="Primary">
      <a href="/solutions/" aria-current={path.startsWith('/solutions/') && !path.includes('/bundles/') ? 'page' : undefined}>Solutions</a>
      <a href="/solutions/bundles/" aria-current={path.includes('/solutions/bundles/') ? 'page' : undefined}>Bundles</a>
      <a href="/custom-automation/" aria-current={path === "/custom-automation/" || path === "/consultation/" ? "page" : undefined}>Custom automation</a>
      <a href="/#how-it-works">How it works</a>
      <a class="nav-cta" href="/demo/" aria-current={path === '/demo/' ? 'page' : undefined}>Request a demo <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<noscript><style>.menu-toggle{display:none!important}@media(max-width:900px){.header-inner{flex-wrap:wrap;padding-block:15px}.nav{display:flex;position:static;flex-wrap:wrap;border:0;box-shadow:none;padding:0;background:transparent;font-size:14px;gap:15px}.nav-cta{padding:8px 10px}}</style></noscript>
<script>
 const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
 const nav = document.querySelector<HTMLElement>('#site-nav');
 const close = () => { toggle?.setAttribute('aria-expanded','false'); nav?.classList.remove('is-open'); };
 toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded',String(open)); nav?.classList.toggle('is-open',open); });
 nav?.addEventListener('click', event => { if (event.target instanceof Element && event.target.closest('a')) close(); });
 document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); } });
</script>
