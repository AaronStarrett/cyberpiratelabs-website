---
interface Props {
  variant: "voice" | "chat";
}

const { variant } = Astro.props;
const source = `/illustrations/cpl-pirate-agent-${variant}`;
---

<div class:list={["pirate-agent", `pirate-agent--${variant}`]} aria-hidden="true">
  <img
    class="pirate-agent__portrait"
    src={`${source}.webp`}
    srcset={`${source}.webp 480w, ${source}@2x.webp 960w`}
    sizes="(max-width: 360px) 114px, (max-width: 900px) 124px, (max-width: 1150px) 146px, 200px"
    width="480"
    height="480"
    alt=""
    loading="lazy"
    decoding="async"
  />
  {variant === "voice" ? (
    <svg class="pirate-agent__signal" viewBox="0 0 40 52" fill="none" focusable="false">
      <path d="M28 17a13 13 0 0 0 0 18" />
      <path d="M20 10a23 23 0 0 0 0 32" />
      <path d="M12 3a33 33 0 0 0 0 46" />
    </svg>
  ) : (
    <svg class="pirate-agent__typing" viewBox="0 0 184 64" focusable="false">
      <circle cx="23" cy="23" r="21" />
      <circle cx="91" cy="32.5" r="21" />
      <circle cx="160.5" cy="38.5" r="21" />
    </svg>
  )}
</div>

<style>
  .pirate-agent {
    position: absolute;
    z-index: 2;
    top: 16px;
    right: 24px;
    width: 200px;
    aspect-ratio: 1;
    pointer-events: none;
    user-select: none;
    isolation: isolate;
  }

  .pirate-agent__portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 9px 8px #052b4e1b);
    transform-origin: 52% 76%;
  }

  /* The complete accessories are in the raster. These accents only react briefly. */
  .pirate-agent__signal {
    position: absolute;
    left: 17%;
    top: 59%;
    width: 11%;
    height: 16%;
    stroke: #d0fff3;
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0;
  }

  .pirate-agent__typing {
    position: absolute;
    left: 72.57%;
    top: 55.98%;
    width: 14.67%;
    height: auto;
    fill: #31dcc7;
  }

  .pirate-agent__typing circle { opacity: 0; }

  @keyframes pirate-listen {
    0%, 100% { transform: rotate(0); }
    45% { transform: rotate(-2deg); }
  }

  @keyframes pirate-signal {
    0%, 100% { opacity: 0; transform: scale(.94); }
    40% { opacity: .9; transform: scale(1.04); }
  }

  @keyframes pirate-greet {
    0%, 100% { transform: translateY(0); }
    45% { transform: translateY(-3px); }
  }

  @keyframes pirate-type {
    0%, 100% { opacity: 0; transform: translateY(0); }
    45% { opacity: 1; transform: translateY(-2px); }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.service-panel:focus-within) .pirate-agent--voice .pirate-agent__portrait {
      animation: pirate-listen 800ms ease-in-out 1;
    }
    :global(.service-panel:focus-within) .pirate-agent__signal {
      animation: pirate-signal 800ms ease-in-out 1;
    }
    :global(.service-panel:focus-within) .pirate-agent--chat .pirate-agent__portrait {
      animation: pirate-greet 800ms ease-in-out 1;
    }
    :global(.service-panel:focus-within) .pirate-agent__typing circle {
      animation: pirate-type 650ms ease-in-out 1;
    }

    @media (hover: hover) {
      :global(.service-panel:hover) .pirate-agent--voice .pirate-agent__portrait {
        animation: pirate-listen 800ms ease-in-out 1;
      }
      :global(.service-panel:hover) .pirate-agent__signal {
        animation: pirate-signal 800ms ease-in-out 1;
      }
      :global(.service-panel:hover) .pirate-agent--chat .pirate-agent__portrait {
        animation: pirate-greet 800ms ease-in-out 1;
      }
      :global(.service-panel:hover) .pirate-agent__typing circle {
        animation: pirate-type 650ms ease-in-out 1;
      }
    }
  }

  .pirate-agent__typing circle:nth-child(2) { animation-delay: 100ms; }
  .pirate-agent__typing circle:nth-child(3) { animation-delay: 200ms; }

  @media (max-width: 1150px) {
    .pirate-agent { width: 146px; top: 18px; right: 22px; }
    :global(.service-panel .service-number) { margin-bottom: 76px; }
  }

  @media (max-width: 900px) {
    .pirate-agent { width: 124px; top: 18px; right: 20px; }
    :global(.service-panel .service-number) { margin-bottom: 68px; }
  }

  @media (max-width: 680px) {
    .pirate-agent { right: 22px; }
    :global(.service-panel .service-number) { margin-bottom: 62px; }
  }

  @media (max-width: 360px) {
    .pirate-agent { width: 114px; right: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pirate-agent__portrait,
    .pirate-agent__signal,
    .pirate-agent__typing circle { animation: none !important; }
  }
</style>
