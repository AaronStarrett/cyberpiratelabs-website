---
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/InquiryForm.astro";
import ProductStage from "../islands/ProductStage";
import { faqs } from "../../shared/site";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Cyber Pirate Labs, LLC",
    url: "https://cyberpiratelabs.com",
    logo: "https://cyberpiratelabs.com/brand/cpl-logo.png",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "CPL Command Center",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    creativeWorkStatus: "Early access. In development.",
    description: "Early-access workflow software for service companies. This website is an interactive preview with sample data.",
    provider: { "@type": "Organization", name: "Cyber Pirate Labs, LLC" },
  },
];
---
<Base
  title="CPL Command Center | Cyber Pirate Labs"
  description="Less chasing. More work moving. CPL Command Center is an early-access preview that follows one sample job from the request to the report."
  jsonLd={jsonLd}
>
  <ProductStage client:load />
  <noscript>
    <p class="wrap noscript-note">The sample opens on a roof assessment for 18 Cedar Wharf. Access notes are missing. The story controls need JavaScript.</p>
  </noscript>
  <section class="sheet contact-sheet" id="contact" aria-labelledby="contact-title">
    <div class="wrap contact-grid">
      <div>
        <p class="kicker">Contact</p>
        <h2 id="contact-title">Where does work get stuck?</h2>
        <p>Name the workflow. An inquiry is not a booked meeting. Prices and timing stay in the conversation, not on this page.</p>
        <h3>Questions</h3>
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <InquiryForm sourcePath="/" showLead={false} />
    </div>
  </section>
</Base>
