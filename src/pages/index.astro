---
import Base from "../layouts/Base.astro";
import HeroStage from "../components/HeroStage.astro";
import PirateAgentIllustration from "../components/PirateAgentIllustration.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import AgentExperience from "../islands/AgentExperience";
import {agentFaqs} from "../../shared/site";
const jsonLd = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Cyber Pirate Labs, LLC', url: 'https://cyberpiratelabs.com', logo: 'https://cyberpiratelabs.com/brand/cpl-logo.png', description: 'Business AI voice and chat agent configuration, implementation, integration, testing, and ongoing management.' };
---
<Base title="CPL AI Voice & Chat Agents | Cyber Pirate Labs" description="Your next customer starts with a conversation. AI voice and chat agents configured, connected, tested, and managed for your business by Cyber Pirate Labs." jsonLd={jsonLd}>
 <section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="signal-dot"></span> CPL AI VOICE + CHAT AGENTS</p><h1>Your next customer starts with a <span>conversation.</span></h1><p class="hero-summary">AI agents that answer routine questions, capture useful lead details, and guide customers to the next step—configured and managed for your business.</p><div class="hero-actions"><a class="button" href="/demo/">Request a CPL Demo <span aria-hidden="true">↗</span></a><a class="text-link" href="#experience">Explore the Experience <span aria-hidden="true">↓</span></a></div><div class="hero-footnote"><span>YOUR BUSINESS INFORMATION.</span><span>YOUR APPROVED NEXT STEP.</span></div></div><HeroStage /></div><div class="wrap hero-strip"><span>01 <strong>A conversation arrives.</strong></span><span aria-hidden="true">→</span><span>02 <strong>The right details take shape.</strong></span><span aria-hidden="true">→</span><span>03 <strong>Your business has a next step.</strong></span></div></section>
 <section id="experience" class="experience-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Step inside the conversation</p><h2>From “hello”<br />to something useful.</h2></div><p>Switch between voice and chat. Choose a fictional business. Watch the request become organized details for the team.</p></div><AgentExperience client:visible /><p class="experience-note">An interactive transcript walkthrough. No audio, microphone, live AI, or real inquiries.</p></div></section>
 <section class="services-section" id="services"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Two ways to start. One thoughtful service.</p><h2>Meet your next<br />first point of contact.</h2></div><p>A caller on the phone. A visitor on your website. Both deserve a clear answer and a sensible next step.</p></div><div class="service-duo"><article class="service-panel voice-panel"><span class="service-number">01 / ON THE PHONE</span><PirateAgentIllustration variant="voice" /><h3>CPL AI<br />Voice Agents</h3><p>Handle routine inbound questions, gather relevant details, and guide callers through configured follow-up—even outside your regular hours.</p><a class="text-link" href="/voice-agents/">Explore voice agents <span aria-hidden="true">↗</span></a><div class="service-bottom"><span>ANSWER</span><span>QUALIFY</span><span>ROUTE</span></div></article><article class="service-panel chat-panel"><span class="service-number">02 / ON YOUR WEBSITE</span><PirateAgentIllustration variant="chat" /><h3>CPL AI<br />Chat Agents</h3><p>Help visitors understand your services, ask useful follow-up questions, and turn website conversations into organized requests.</p><a class="text-link" href="/chat-agents/">Explore chat agents <span aria-hidden="true">↗</span></a><div class="service-bottom"><span>EXPLAIN</span><span>CAPTURE</span><span>GUIDE</span></div></article></div></div></section>
 <section id="use-cases" class="use-cases"><div class="wrap use-case-layout"><div class="sticky-copy"><p class="eyebrow">Recognizable requests. Better beginnings.</p><h2>Built around<br />the conversations<br /><span>you already have.</span></h2><p>Service businesses are a natural fit. These are examples of the work we can explore together.</p><a class="text-link" href="/demo/">Find your business fit ↗</a></div><div class="scenario-list"><article><span>01 / REMODELING</span><h3>“We’re planning a bathroom remodel.”</h3><p>Capture the project type, location, and desired timing so the team has useful context for a follow-up.</p><small>PROJECT INQUIRY → TEAM REVIEW</small></article><article><span>02 / CLEANING</span><h3>“Do you clean homes in our area?”</h3><p>Explain the approved service area, ask about the type of cleaning, and collect details for the next conversation.</p><small>SERVICE QUESTION → CLEAR REQUEST</small></article><article><span>03 / HOME SERVICES</span><h3>“Can someone discuss a maintenance visit?”</h3><p>Understand a routine request and guide the customer to the agreed next step. Unknowns stay visible.</p><small>ROUTINE REQUEST → CONFIGURED FOLLOW-UP</small></article></div></div></section>
 <section id="how-it-works" class="process-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">We do the work behind the conversation</p><h2>Thoughtfully configured.<br />Thoroughly put to the test.</h2></div><p>Custom implementation and ongoing management. CPL helps you get from business context to a working, reviewed service.</p></div><ol class="process-list"><li><span>01</span><h3>Discover</h3><p>Your services, common questions, and what a useful next step looks like.</p></li><li><span>02</span><h3>Configure</h3><p>Approved knowledge, tone, qualification questions, and boundaries.</p></li><li><span>03</span><h3>Connect</h3><p>The supported business destinations agreed for your implementation.</p></li><li><span>04</span><h3>Test</h3><p>Realistic conversations, unknown questions, and handoff situations.</p></li><li><span>05</span><h3>Launch &amp; improve</h3><p>Review the service and maintain it as your business information changes.</p></li></ol></div></section>
 <section class="connections-section"><div class="wrap connection-layout"><div><p class="eyebrow">Fit the way your business works</p><h2>A conversation<br />should go somewhere.</h2><p>Useful information belongs where your team can act on it. We assess, scope, and test the supported connections for your workflow.</p><a class="text-link" href="/demo/">Discuss your connections ↗</a></div><div class="connection-flow"><div class="flow-source"><span aria-hidden="true">↗ &nbsp; ···</span><strong>Call or chat</strong><small>Your approved conversation</small></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="flow-details"><strong>Useful inquiry details</strong><span>Service · Location · Context · Contact</span></div><div class="flow-arrow" aria-hidden="true">↓</div><div class="flow-destinations"><span>CRM record</span><span>Team notification</span><span>Booking process</span></div><p>Illustrative destinations. Availability and scope depend on the supported connection. A booking link and a confirmed appointment are different steps.</p></div></div></section>
 <section id="faq" class="faq-section"><div class="wrap faq-layout"><div><p class="eyebrow">The practical questions</p><h2>Clear answers.<br />Clear expectations.</h2><p>Your information, your rules, and people involved where they’re needed.</p></div><div class="faq-list">{agentFaqs.map(faq => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></div></section>
 <ClosingCTA />
</Base>
