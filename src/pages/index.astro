---
import Base from "../layouts/Base.astro";
import HeroStage from "../components/HeroStage.astro";
import PirateAgentIllustration from "../components/PirateAgentIllustration.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import ProblemFinder from "../components/ProblemFinder.astro";
import AgentExperience from "../islands/AgentExperience";
import {agentFaqs} from "../../shared/site";
import {bundles} from "../../shared/solutions";
import "../styles/solution-home.css";
const jsonLd = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Cyber Pirate Labs, LLC', url: 'https://cyberpiratelabs.com', logo: 'https://cyberpiratelabs.com/brand/cpl-logo.png', description: 'Inquiry capture, approved answers, customer guidance and procedure help, configured and managed by Cyber Pirate Labs.' };
---
<Base title="Business Solutions for a Clear Next Step | Cyber Pirate Labs" description="Answer routine questions, capture useful requests and guide customers to the right person or booking page. Explore ten CPL voice and chat solutions and four practical bundles." jsonLd={jsonLd}>
 <section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="signal-dot"></span> BUSINESS PROBLEMS. USEFUL RESULTS.</p><h1>Give every inquiry a <span>clear next step.</span></h1><p class="hero-summary">Help people get an answer, explain what they need, and reach the right person or booking page. CPL configures and manages voice or chat assistance around your business.</p><div class="hero-actions"><a class="button" href="#solutions">Find your solution ↓</a><a class="text-link" href="/demo/">Request a demo ↗</a></div><div class="hero-footnote"><span>YOUR APPROVED INFORMATION.</span><span>CUSTOM-QUOTED SETUP + MANAGEMENT.</span></div></div><HeroStage /></div><div class="wrap hero-strip"><span>01 <strong>Answer the routine question.</strong></span><span aria-hidden="true">→</span><span>02 <strong>Capture the useful context.</strong></span><span aria-hidden="true">→</span><span>03 <strong>Keep the next person informed.</strong></span></div></section>
 <ProblemFinder />
 <section id="experience" class="experience-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">See the useful result take shape</p><h2>From “how much?”<br />to a reviewable request.</h2></div><p>Follow a fictional bathroom-remodel inquiry as a chat gathers the details an estimating team needs. A person still reviews the request and prepares the quote.</p></div><AgentExperience solution="ready-to-review-quote-requests" client:visible /><p class="experience-note">Scripted illustrative demonstration · Fictional business · No live conversation, email or quote.</p></div></section>
 <section class="home-bundles" id="use-cases"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Useful together</p><h2>A few connected needs.<br /><span>One clear route.</span></h2></div><p>Related services can share one configured voice or chat experience. The customer’s need determines the route; people own the next action.</p></div><div class="bundle-teasers">{bundles.map(bundle => <article class="bundle-teaser"><p class="eyebrow">BUNDLE {bundle.label} / {bundle.delivery === 'voice' ? 'VOICE' : 'CHAT'}</p><h3>{bundle.name}</h3><p>{bundle.summary}</p><p class="bundle-preview-steps">{bundle.steps.map(step => step.title).join(' → ')}</p><a class="text-link" href={`/solutions/bundles/#${bundle.slug}`}>Explore the connected workflow ↗</a></article>)}</div><p class="scope-summary">An email reaches the agreed inbox. A booking link is completed by the customer. A staff member uses a procedure to do the work. Voice and chat remain separate entry points.</p></div></section>
 <section id="how-it-works" class="process-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">We configure the assistance behind the outcome</p><h2>Your information.<br />Your handoff rules.</h2></div><p>Custom-quoted implementation and ongoing management. We agree the content, human destination and service boundaries before launch.</p></div><ol class="process-list"><li><span>01</span><h3>Define</h3><p>Choose the problem and the information a useful response needs.</p></li><li><span>02</span><h3>Configure</h3><p>Approve answers, questions, source material and next-step rules.</p></li><li><span>03</span><h3>Connect</h3><p>Set the agreed inbox, one transfer number or existing booking link.</p></li><li><span>04</span><h3>Test</h3><p>Review sample conversations, unanswered calls, uncertainty and human handoffs.</p></li><li><span>05</span><h3>Manage</h3><p>Launch after review, then maintain approved information as it changes.</p></li></ol></div></section>
 <section id="services" class="services-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">The delivery behind the solution</p><h2>On the phone.<br />On your website.</h2></div><p>Choose the business outcome first. Voice and chat are the ways CPL delivers the agreed assistance.</p></div><div class="service-duo"><article class="service-panel voice-panel"><span class="service-number">VOICE / INBOUND CALLS</span><PirateAgentIllustration variant="voice" /><h3>A useful first<br />phone response.</h3><p>Approved questions, focused screening, one human transfer destination or a captured message for the team.</p><a class="text-link" href="/voice-agents/">How voice delivery works ↗</a><div class="service-bottom"><span>ANSWER</span><span>SCREEN</span><span>HUMAN FOLLOW-UP</span></div></article><article class="service-panel chat-panel"><span class="service-number">CHAT / GUIDED CONVERSATIONS</span><PirateAgentIllustration variant="chat" /><h3>A clearer path<br />through the website.</h3><p>Approved information, a structured request, helpful guidance and a visible next step.</p><a class="text-link" href="/chat-agents/">How chat delivery works ↗</a><div class="service-bottom"><span>EXPLAIN</span><span>CAPTURE</span><span>GUIDE</span></div></article></div></div></section>
 <section id="faq" class="faq-section"><div class="wrap faq-layout"><div><p class="eyebrow">The practical questions</p><h2>Clear answers.<br />Clear expectations.</h2><p>Your information, your rules, and people involved where they’re needed.</p></div><div class="faq-list">{agentFaqs.map(faq => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></div></section>
 <ClosingCTA />
</Base>
