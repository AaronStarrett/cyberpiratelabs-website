---
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/InquiryForm.astro";
import "../styles/custom-automation.css";
---
<Base title="Custom Automation Consultation | Cyber Pirate Labs" description="Describe your business process and desired outcome. Request a CPL custom automation consultation to assess feasibility, access, security and an appropriate scope.">
  <section class="demo-request"><div class="wrap contact-grid"><div class="contact-copy"><p class="eyebrow">Custom automation / Start with the process</p><h1>Where does work<br /><span>get stuck?</span></h1><p class="hero-summary">Have a workflow our ten core services do not cover? Tell us about the process, the tools involved and the outcome you need.</p><div class="demo-expectations"><span>01</span><p>Understand the repeated work and the business problem.</p><span>02</span><p>Assess technical feasibility, authorized access and security requirements.</p><span>03</span><p>Define a proposed scope, budget, timeline and acceptance checks for approval.</p></div><p class="custom-form-note">This requests a consultation. It does not approve implementation, confirm a meeting, or guarantee that the proposed automation is feasible. Please leave out confidential customer records, passwords and payment details.</p><div class="contact-path-links"><a class="text-link" href="/custom-automation/">Explore the custom automation process <span aria-hidden="true">&nearr;</span></a><a class="text-link" href="/solutions/">See the ten core solutions <span aria-hidden="true">&nearr;</span></a></div><a class="text-link" href="mailto:astarrett@cyberpiratelabs.com?subject=Custom%20Automation%20Consultation">Prefer email? Contact CPL <span aria-hidden="true">&nearr;</span></a></div><InquiryForm sourcePath="/consultation/" requestKind="custom" /></div></section>
</Base>
