---
import Base from "../../../layouts/Base.astro";
import BundleFlow from "../../../components/BundleFlow.astro";
import { bundles, getSolution, demoRequestHref } from "../../../../shared/solutions";
import "../../../styles/solutions.css";
---
<Base title="Business Solution Bundles | Cyber Pirate Labs" description="Four practical combinations of voice or chat assistance, with clear routes for leads, phone inquiries, customer care and staff knowledge.">
  <section class="solutions-hub-intro bundle-hub-intro"><div class="wrap"><nav class="solution-breadcrumb" aria-label="Breadcrumb"><a href="/solutions/">All solutions</a><span aria-hidden="true">/</span><span>Bundles</span></nav><p class="eyebrow"><span class="signal-dot"></span>Four useful combinations</p><div class="solutions-hub-heading"><h1>Give each need<br /><span>the right route.</span></h1><div><p>Related solutions can work together in a single configured voice or chat service. The useful part is knowing what happens next—and who takes it from there.</p><p>Each bundle is scoped and custom-quoted for your business.</p></div></div><nav class="solution-group-nav" aria-label="Bundle workflows">{bundles.map(bundle => <a href={`#${bundle.slug}`}>{bundle.name}<span aria-hidden="true">↓</span></a>)}</nav></div></section>
  <div class="bundle-catalog wrap">
    {bundles.map((bundle, index) => <section id={bundle.slug} class="bundle-overview" aria-labelledby={`${bundle.slug}-heading`}><div class="bundle-overview-copy"><p class="eyebrow">{String(index + 1).padStart(2, "0")} / {bundle.delivery === "voice" ? "Voice" : "Chat"} bundle</p><h2 id={`${bundle.slug}-heading`}>{bundle.name}</h2><p class="bundle-headline">{bundle.headline}</p><p>{bundle.summary}</p><ul class="bundle-service-links">{bundle.solutionSlugs.map(slug => { const solution = getSolution(slug); return solution && <li><a href={`/solutions/${solution.slug}/`}>{solution.name}<span aria-hidden="true">↗</span></a></li>; })}</ul><div class="bundle-actions"><a class="button" href={demoRequestHref({ bundle: bundle.slug })}>Show me this bundle <span aria-hidden="true">↗</span></a><a class="text-link" href={`/solutions/bundles/${bundle.slug}/`}>Explore the fit <span aria-hidden="true">↗</span></a></div></div><BundleFlow bundle={bundle} /></section>)}
  </div>
  <section class="solution-closing"><div class="wrap"><div><p class="eyebrow">Start with one need</p><h2>A smaller starting point works too.</h2><p>Explore the individual solutions and choose the problem that matters most right now.</p></div><a class="button" href="/solutions/">Find your solution <span aria-hidden="true">↗</span></a></div></section>
</Base>
