---
import Base from "../layouts/Base.astro";
---
<Base
  title="Page not found | Cyber Pirate Labs"
  description="That page is not part of the Cyber Pirate Labs site."
>
  <section class="page-intro">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page is not on this site.</h1>
      <p>The address does not match a Command Center page. The preview and the inquiry form are still available.</p>
      <p>
        <a class="button" href="/">Back to the preview</a>
        <a class="button secondary" href="/contact/">Contact</a>
      </p>
    </div>
  </section>
</Base>
