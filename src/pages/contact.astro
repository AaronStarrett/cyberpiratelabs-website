---
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/InquiryForm.astro";
---
<Base
  title="Request a demo | Cyber Pirate Labs"
  description="Request a demo of CPL Command Center. The form stores an inquiry. It does not book a meeting."
>
  <section class="page-intro">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Request a demo</h1>
      <p class="contact-mail">Or write <a href="mailto:AStarrett@cyberpiratelabs.com">AStarrett@cyberpiratelabs.com</a>.</p>
      <InquiryForm sourcePath="/contact/" />
    </div>
  </section>
</Base>
