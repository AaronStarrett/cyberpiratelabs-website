---
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/agent-site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props { title: string; description: string; jsonLd?: Record<string, unknown> | Record<string, unknown>[]; }
const {title, description, jsonLd} = Astro.props;
const indexable = import.meta.env.PUBLIC_INDEXABLE === "true";
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/og.png", Astro.site);
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical.href} /><meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical.href} /><meta property="og:image" content={image.href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Cyber Pirate Labs business solutions: give every inquiry a clear next step." /><meta name="twitter:card" content="summary_large_image" /><meta name="theme-color" content="#052B4E" /><link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png" /><link rel="apple-touch-icon" href="/icons/icon-180.png" />{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<','\u003c')} />}</head><body><a class="skip" href="#content">Skip to content</a><Header /><main id="content"><slot /></main><Footer /></body></html>
