{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberpiratelabs-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cpl-website-inquiries-preview",
      "database_id": "5bf0d631-d3ee-452c-9ed7-bf516229080b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "preview"
  },
  "env": {
    "production": {
      "name": "cyberpiratelabs-website-production",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cpl-website-inquiries-production",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": ["*/15 * * * *"]
      }
    }
  }
}
